<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme (used after splash) -->
    <style name="Theme.Columba" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash: white field with the LCS logo, shown from the first frame while
         the app loads. The system splash is icon-only; the wordmark is added by
         the in-app overlay (LcsBrandedSplashOverlay) on the same white field. -->
    <style name="Theme.Columba.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Columba</item>
    </style>
</resources>
