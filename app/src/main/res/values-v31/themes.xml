<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) adds a branding-image slot at the bottom of the splash
         screen. This is a platform attribute, so it can only be referenced here. -->
    <style name="Theme.Columba.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Columba</item>
    </style>
</resources>
